---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import { getPostsForPerson, getPersonReferenceCount, getInterviewsForPerson } from '@/lib/xref';
import PersonProfileHeader from '@/components/PersonProfileHeader';
import LinkCardList, { type LinkCardItem } from '@/components/LinkCardList';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({ params: { personId: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

const [posts, referenceCount, interviews] = await Promise.all([
  getPostsForPerson(person.id),
  getPersonReferenceCount(person.id),
  getInterviewsForPerson(person.id),
]);

const interviewItems: LinkCardItem[] = interviews.map((interview) => ({
  href: `/interviews/${interview.id}/`,
  title: interview.data.title,
  description: `${interview.data.channel} · ${interview.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}`,
}));

const postItems: LinkCardItem[] = posts.map((post) => ({
  href: `/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
}));
---

<StarlightPage frontmatter={{ title: person.data.name, description: person.data.profession }}>
  <PersonProfileHeader
    name={person.data.name}
    role={person.data.role}
    profession={person.data.profession}
    photo={person.data.photo}
    links={person.data.links}
  />

  <Content />

  <h2>Entrevistas ({interviews.length})</h2>
  <LinkCardList items={interviewItems} emptyLabel="Sin entrevistas todavía." />

  <h2>Posts que le referencian ({posts.length}, {referenceCount} citas en total)</h2>
  <LinkCardList items={postItems} emptyLabel="Sin posts todavía." />
</StarlightPage>
