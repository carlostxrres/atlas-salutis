---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import PeopleSearch, { type PersonSummary } from '@/components/PeopleSearch';

const people = await getCollection('people');
const summaries: PersonSummary[] = people
  .map((person) => ({
    id: person.id,
    name: person.data.name,
    role: person.data.role,
    profession: person.data.profession,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<StarlightPage frontmatter={{ title: 'Personas' }}>
  <PeopleSearch people={summaries} client:load />
</StarlightPage>
