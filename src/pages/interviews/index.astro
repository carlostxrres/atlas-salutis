---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import InterviewsSearch, { type InterviewSummary } from '@/components/InterviewsSearch';
import { getYouTubeVideoId, getYouTubeThumbnailUrl } from '@/lib/youtube';
import { excerpt } from '@/lib/utils';

const interviews = await getCollection('interviews');
const summaries: InterviewSummary[] = interviews
  .map((interview) => {
    // `undefined` for placeholder urls, in which case the card falls back to
    // an icon tile instead of a broken image — see `getYouTubeVideoId`.
    const videoId = getYouTubeVideoId(interview.data.youtubeUrl);

    return {
      id: interview.id,
      title: interview.data.title,
      channel: interview.data.channel,
      // ISO stays the sort key and the `<time datetime>` value; `dateLabel` is
      // what the card actually shows.
      date: interview.data.date.toISOString().slice(0, 10),
      dateLabel: interview.data.date.toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      }),
      durationMinutes: interview.data.durationMinutes,
      thumbnail: videoId ? getYouTubeThumbnailUrl(videoId) : undefined,
      excerpt: excerpt(interview.data.summary),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date));
---

<StarlightPage frontmatter={{ title: 'Entrevistas', tableOfContents: false }}>
  <InterviewsSearch interviews={summaries} client:load />
</StarlightPage>
