---
import { getEntry } from 'astro:content';
import AuthorHeaderList, { type AuthorSummary } from './AuthorHeaderList';
import { getPersonPhoto } from '@/lib/people';

interface Props {
  // Deduplicated person ids, e.g. from `getAuthorsForPost()` in `@/lib/xref`.
  personIds: string[];
}

const { personIds } = Astro.props;

const people: AuthorSummary[] = (await Promise.all(personIds.map((id) => getEntry('people', id))))
  .filter((person) => person !== undefined)
  .map((person) => ({
    id: person.id,
    name: person.data.name,
    profession: person.data.profession,
    photo: getPersonPhoto(person.id),
  }));
---

<AuthorHeaderList people={people} />
